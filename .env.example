# Copy to .env and fill in. The .env file is read by both Next.js and the Prisma
# CLI, which is why there is one of it rather than two that drift apart.

# --- Database -------------------------------------------------------------
# Local Postgres. `prisma migrate dev` runs against this and nothing else: it
# needs a shadow database and generates DROP statements from drift, so pointing
# it at a shared Supabase project is how you lose a table.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mun_ops_dev"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/mun_ops_dev"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mun_ops_shadow"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mun_ops_test"

# --- Supabase -------------------------------------------------------------
# The project root only, with no path. The client appends /auth/v1, /rest/v1 and
# /storage/v1 itself.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server only. Bypasses every policy. Must never gain a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Behaviour ------------------------------------------------------------
# Fails closed. Attaches stack traces to 5xx response bodies when on.
EXPOSE_ERROR_DETAILS="false"

# --- Rate limiting ---------------------------------------------------------
# Upstash Redis, REST API. Required for the public registration endpoint.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Storage ---------------------------------------------------------------
# S3-compatible, private bucket. All five blank is a supported state: uploads
# answer 503 and registration still works without a payment screenshot.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
